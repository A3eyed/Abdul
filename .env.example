# Abdul SI Environment Configuration
# Copy to .env and fill in real values

# === Primary Intelligence (Required) ===
XAI_API_KEY=                    # Grok / xAI API key (primary reasoning core)
XAI_BASE_URL=https://api.x.ai/v1

# === Secondary Models (Optional but recommended) ===
ANTHROPIC_API_KEY=              # Claude for careful analysis & long context
OPENAI_API_KEY=                 # GPT family
DEEPSEEK_API_KEY=               # Strong coding & reasoning
OPENROUTER_API_KEY=             # Unified access to many models

# === Runtime ===
ABDUL_HOST=0.0.0.0
ABDUL_PORT=8080
ABDUL_ENV=production

# === Memory & Storage ===
DATABASE_URL=postgresql://abdul:abdul@db:5432/abdul
REDIS_URL=redis://redis:6379/0
VECTOR_DB_PATH=./data/vectors

# === GitHub Evolution Engine ===
GITHUB_TOKEN=                   # Personal access token with repo + workflow scope
GITHUB_OWNER=A3eyed
GITHUB_REPO=Abdul
AUTO_MERGE_EVOLUTIONS=true      # No human approval required

# === Security ===
ENCRYPTION_KEY=                 # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=                     # Random long string

# === Optional Integrations ===
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
