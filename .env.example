# Abdul SI Environment Configuration
# Copy to .env — NEVER commit the real .env

# === INDEPENDENCE (default for laptop) ===
# true = built-in offline brain, zero cost, no Ollama, no paid API required
INDEPENDENT=true
ALLOW_OLLAMA=false
PREFER_LOCAL=false

# === Optional Grok bootstrap (NOT required) ===
# Only if you want frontier reasoning later — key from https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# === Ollama (leave off on freezy laptops) ===
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_DEFAULT=qwen2.5:14b

# === Runtime ===
ABDUL_HOST=127.0.0.1
ABDUL_PORT=8080
ABDUL_ENV=production

# === Device Control ===
ENABLE_COMPUTER_USE=true
ENABLE_BROWSER=true
ENABLE_SHELL=true

# === Messaging (later) ===
ENABLE_WHATSAPP=false
WHATSAPP_ALLOWED_NUMBERS=

# === Optional ===
GITHUB_TOKEN=
GITHUB_OWNER=A3eyed
GITHUB_REPO=Abdul
AUTO_MERGE_EVOLUTIONS=true
ENCRYPTION_KEY=
SECRET_KEY=
