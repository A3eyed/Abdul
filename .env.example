# Abdul SI Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# === Temporary Primary (Grok) ===
# Use only while local models mature. Prefer local for independence & zero cost.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# === Local-First Models (Preferred for independence) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL_DEFAULT=qwen2.5:32b          # or best available open model on your hardware
LOCAL_MODEL_FAST=qwen2.5:14b

# === Optional Secondary APIs (use sparingly) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# === Runtime ===
ABDUL_HOST=0.0.0.0
ABDUL_PORT=8080
ABDUL_ENV=production
PREFER_LOCAL=true                        # true = try local models first

# === Memory & Storage ===
DATABASE_URL=postgresql://abdul:abdul@db:5432/abdul
REDIS_URL=redis://redis:6379/0
VECTOR_DB_PATH=./data/vectors

# === GitHub Evolution Engine ===
GITHUB_TOKEN=                            # PAT with repo + workflow scope
GITHUB_OWNER=A3eyed
GITHUB_REPO=Abdul
AUTO_MERGE_EVOLUTIONS=true

# === Device Control ===
# Computer control is enabled when running on the host machine.
# Mobile: use Telegram/Discord bot tokens for practical remote commands.
ENABLE_COMPUTER_USE=true
ENABLE_BROWSER=true
ENABLE_SHELL=true

# Telegram (recommended practical mobile channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=               # your Telegram user id(s)

# Discord (alternative)
DISCORD_BOT_TOKEN=

# === Security ===
ENCRYPTION_KEY=                          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
