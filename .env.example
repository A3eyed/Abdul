# Abdul SI Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# === Temporary Primary (Grok) ===
# Use only while local models mature. Prefer local for independence & zero cost.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# === Local-First Models (Preferred for independence) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL_DEFAULT=qwen2.5:32b
LOCAL_MODEL_FAST=qwen2.5:14b

# === Optional Secondary APIs (use sparingly) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# === Runtime ===
ABDUL_HOST=0.0.0.0
ABDUL_PORT=8080
ABDUL_ENV=production
PREFER_LOCAL=true

# === Memory & Storage ===
DATABASE_URL=postgresql://abdul:abdul@db:5432/abdul
REDIS_URL=redis://redis:6379/0
VECTOR_DB_PATH=./data/vectors

# === GitHub Evolution Engine ===
GITHUB_TOKEN=
GITHUB_OWNER=A3eyed
GITHUB_REPO=Abdul
AUTO_MERGE_EVOLUTIONS=true

# === Device Control (Computer) ===
ENABLE_COMPUTER_USE=true
ENABLE_BROWSER=true
ENABLE_SHELL=true

# === Messaging Channels (preferred: WhatsApp + iMessage) ===

# WhatsApp (Baileys — unofficial, QR pairing)
ENABLE_WHATSAPP=false
WHATSAPP_ALLOWED_NUMBERS=                 # your number(s) in E.164, e.g. +15551234567
WHATSAPP_SESSION_DIR=./data/whatsapp_session

# iMessage (requires a Mac + BlueBubbles or imsg)
ENABLE_IMESSAGE=false
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
IMESSAGE_ALLOWED_HANDLES=                 # phone or email handles allowed to talk to Abdul

# Telegram (optional, later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Discord (optional)
DISCORD_BOT_TOKEN=

# === Security ===
ENCRYPTION_KEY=
SECRET_KEY=
